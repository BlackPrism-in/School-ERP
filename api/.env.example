# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Supabase: Project Settings > Database > Connection string (use the pooler
# URI for serverless, the direct URI for a long-running server like this one).
DATABASE_URL=postgres://postgres:password@localhost:5432/edunova

# Role the API downgrades to per transaction. Must NOT be the table owner and
# must NOT have BYPASSRLS — this is what makes the RLS policies real.
# Leave as erp_app unless you connect as erp_app directly, then set empty.
DB_APP_ROLE=erp_app
DB_POOL_MAX=10

# Single-tenant deployment: the school this instance serves.
TENANT_SLUG=demo-school

SESSION_COOKIE_NAME=edunova_session
SESSION_TTL_HOURS=12
SESSION_RENEW_WITHIN_HOURS=4
# MUST be true in production. false only for local http development.
COOKIE_SECURE=false
# COOKIE_DOMAIN=.yourschool.edu

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

CORS_ORIGIN=http://localhost:5173
